{
  // 纯逻辑模块的类型检查 (tsc --checkJS): gcj02 / trackutil / track-animation /
  // format / trip-playback / lastpage (都在 static/js/ 子目录)。页面脚本
  // (trips-list.js 等) 依赖高德/echarts 宿主对象, 类型声明成本高, 由 ESLint 把关。
  // types:[] — 不自动引入 node_modules/@types (共享目录里有别的包声明)
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2020",
    "lib": ["dom", "es2020"],
    "types": []
  },
  "include": [
    "app/tesla/static/js/gcj02.js",
    "app/tesla/static/js/trackutil.js",
    "app/tesla/static/js/track-animation.js",
    "app/tesla/static/js/format.js",
    "app/tesla/static/js/trip-playback.js",
    "app/tesla/static/js/lastpage.js",
    "frontend-globals.d.ts"
  ]
}
