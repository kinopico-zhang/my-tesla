# 复制为 .env 并填写; .env 已被 git 忽略
# 高德开放平台 (个人开发者免费): https://console.amap.com/dev/key/app
# Key 的服务平台必须选「Web端 (JS API)」, 安全密钥在 Key 详情页
AMAP_KEY=
AMAP_SECURITY_CODE=

# 以下都是首启默认值 —— 存库后以设置页 (/tesla/settings) 里保存的为准,
# 未在设置页填过的字段才回落到这里 (主机没配时再自动定位 docker 容器)
# TMDB_HOST=
# TMDB_PORT=5432
# TMDB_USER=teslamate
# TMDB_PASS=123456
# TMDB_NAME=teslamate

# 管理员首启种子账号 (种入库后走界面改; 不设则用默认值)
# AUTH_USER=admin
# AUTH_PASS=daozi1994
# SESSION_DAYS=90

# 时区与货币符号 (库内 UTC, 对外输出本地时间)
# TZ_NAME=Asia/Shanghai
# CUR_SYMBOL=¥

# 自有库 / 账号库 (SQLite, 默认在 data/ 下, 一般不用改)
# MYTESLA_DB=data/mytesla.db
# MYTESLA_USERS_DB=data/users.db

# 服务端口: 有证书时 HTTPS 走 PORT, HTTP 走 HTTP_PORT (局域网明文直连);
# 没证书只开 PORT 的明文。HTTP=1 临时只开明文 (调试)。
# PORT=8500
# HTTP_PORT=8501
# HTTP=1
