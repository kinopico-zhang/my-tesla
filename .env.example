# 复制为 .env 并填写; .env 已被 git 忽略
# 首启种子管理员的账密 (种过之后走界面改; 不设 AUTH_PASS 则首启不种
# 管理员, 无法登录 —— 仓库是公开的, 不带默认口令)
AUTH_USER=admin
AUTH_PASS=

# 服务端口: 有证书时 HTTPS 走 PORT, HTTP 走 HTTP_PORT (局域网明文直连);
# 没证书只开 PORT 的明文。HTTP=1 临时只开明文 (调试)。
# PORT=8500
# HTTP_PORT=8501
# HTTP=1

# TeslaMate 库连接 (PostgreSQL)。留空时启动回落 docker 容器定位;
# 都没有则在设置页里填 (存自有库, 改完热重连)。以下是首启默认值 ——
# 存库后以设置页 (/tesla/settings) 里保存的为准
# TMDB_HOST=
# TMDB_PORT=5432
# TMDB_USER=teslamate
# TMDB_PASS=
# TMDB_NAME=teslamate

# 高德开放平台 (个人开发者免费): https://console.amap.com/dev/key/app
# Key 的服务平台必须选「Web端 (JS API)」, 安全密钥在 Key 详情页;
# 也可在设置页里保存。未配置时地图页显示申请指引
# AMAP_KEY=
# AMAP_SECURITY_CODE=
# 地图样式 (默认 amap://styles/dark)
# AMAP_STYLE=

# 可选: 自有库 SQLite (轨迹断档补路等, 默认 data/mytesla.db;
# 要写完整 URL)
# MYTESLA_DB=sqlite:///data/mytesla.db

# 可选: 账号库与会话密钥 (My Home 组合部署时由外层指到共享文件,
# 独立部署默认在仓内; 裸路径相对仓根, 账号库也可写完整 sqlite:///… URL)
# MYHOME_USERS_DB=data/users.db
# MYHOME_SECRET_FILE=.session_secret

# 可选: 显示口径 (默认北京时间 / ¥)
# TZ_NAME=Asia/Shanghai
# CUR_SYMBOL=¥
