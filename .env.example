# 复制成 .env 后按需修改 —— 这是可选文件, 不放它也能起来。
# .env 已在 .gitignore 里: 这里只放模板, 别把密码提交上去。

# 宿主端口 (容器内恒 8500)
MYTESLA_PORT=8500

# 时区 (库内存 UTC 裸时间戳, 这里决定页面上的本地时间)
TZ=Asia/Shanghai
TZ_NAME=Asia/Shanghai

# TeslaMate PostgreSQL 连接 —— 默认留空, 首启由引导页来问。
# 想跳过向导这一步就取消注释并填写 (注意别留空值, 空串会被当作
# 明确设置而导致连接串拼接失败)。接外部 TeslaMate 时 host 填
# 可达的地址, 与本服务同 compose 网络时填库服务名 database。
# TMDB_HOST=database
# TMDB_PORT=5432
# TMDB_USER=teslamate
# TMDB_PASS=your-password
# TMDB_NAME=teslamate

# 会话有效期 (天), 默认 90
# SESSION_DAYS=90
